# Variaveis obrigatorias
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
JWT_SECRET_KEY=substituir-por-secret-seguro

# Runtime de producao
PORT=8080
BRANA_RUNTIME_PROFILE=production
BRANA_ENABLE_SCHEMA_BOOTSTRAP=false
BRANA_ENABLE_RUNTIME_BOOTSTRAP=false
BRANA_ALLOW_HTTP_RUNTIME_BOOTSTRAP=false
BRANA_ALLOW_SCHEMA_COMPAT_APPLY=false
BRANA_SKIP_BOOTSTRAP=true

# Autenticacao e codigos
SIGNUP_CODE_EXP_MINUTES=10
RESET_CODE_EXP_MINUTES=10
PROTECTED_GRANT_EXPIRE_MINUTES=20

# Contas proprietarias/superadmin
OWNER_BYPASS_EMAILS=
OWNER_MASTER_EMAIL=

# Email transacional
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TLS=true
EMAIL_ATTACHMENT_MAX_MB=10

# Google OAuth/Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.seudominio.com.br/auth/google/callback
GOOGLE_CALENDAR_REDIRECT_URI=https://api.seudominio.com.br/auth/google/calendar/callback

# Licenca e pagamentos
LICENCA_SUPORTE_EMAIL=suporte@seudominio.com.br
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_API_BASE=https://api.mercadopago.com
MERCADOPAGO_WEBHOOK_URL=https://api.seudominio.com.br/licenca/mercadopago/webhook
MERCADOPAGO_BACK_URL=https://app.seudominio.com.br
MERCADOPAGO_USE_SANDBOX=false
PAGAMENTO_MENSAL_URL=
PAGAMENTO_ANUAL_URL=
PLANO_MENSAL_VALOR=149.90
PLANO_ANUAL_VALOR=1499.00

# Assinatura PDF
BRANA_PDF_SIGN_TSA_URL=
BRANA_PDF_SIGN_MD_ALG=sha256
BRANA_PDF_SIGN_REASON=Assinado digitalmente
BRANA_PDF_SIGN_LOCATION=Brana Cloude
BRANA_PDF_SIGN_CONTACT=
BRANA_PDF_SIGN_TIMESTAMP_FORMAT=%d/%m/%Y %H:%M:%S
BRANA_PDF_SIGN_PROFILE=pades
