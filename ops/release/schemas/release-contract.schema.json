{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brana.cloude/schemas/release-contract.schema.json",
  "title": "Brana Release Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "environment",
    "result",
    "state",
    "started_at",
    "operator",
    "git_repository",
    "git_branch",
    "git_commit",
    "git_commit_short",
    "build_id",
    "image_repository",
    "ecs_cluster",
    "ecs_service",
    "domain",
    "history"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0.0", "2.0.0"] },
    "release_id": { "type": "string", "minLength": 1 },
    "environment": { "type": "string", "minLength": 1 },
    "result": { "type": "string", "enum": ["PENDING", "SUCCEEDED", "FAILED", "ROLLED_BACK", "ROLLBACK_FAILED", "CANCELLED"] },
    "state": { "type": "string", "enum": ["CREATED", "PREFLIGHT_OK", "BUILT", "PUSHED", "MIGRATED", "DEPLOYING", "VALIDATING", "SUCCEEDED", "FAILED", "ROLLING_BACK", "ROLLED_BACK", "ROLLBACK_FAILED"] },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": ["string", "null"], "format": "date-time" },
    "operator": { "type": "string", "minLength": 1 },
    "git_repository": { "type": "string", "minLength": 1 },
    "git_branch": { "type": "string", "minLength": 1 },
    "git_commit": { "type": "string", "minLength": 1 },
    "git_commit_short": { "type": "string", "minLength": 1 },
    "git_remote_status": { "type": ["string", "null"] },
    "build_id": { "type": "string", "minLength": 1 },
    "snapshot_path": { "type": ["string", "null"] },
    "image_repository": { "type": "string", "minLength": 1 },
    "image_tag": { "type": ["string", "null"] },
    "image_digest": { "type": ["string", "null"] },
    "image_architecture": { "type": ["string", "null"] },
    "ecs_cluster": { "type": "string", "minLength": 1 },
    "ecs_service": { "type": "string", "minLength": 1 },
    "task_definition_before": { "type": ["string", "null"] },
    "task_definition_after": { "type": ["string", "null"] },
    "deployment_id": { "type": ["string", "null"] },
    "target_group_before": { "type": ["string", "null"] },
    "target_group_after": { "type": ["string", "null"] },
    "listener_rule": { "type": ["string", "null"] },
    "domain": { "type": "string", "minLength": 1 },
    "migration_version_before": { "type": ["string", "null"] },
    "migration_version_after": { "type": ["string", "null"] },
    "health_status": { "type": ["string", "null"] },
    "public_smoke_status": { "type": ["string", "null"] },
    "authenticated_smoke_status": { "type": ["string", "null"] },
    "authorization_positive_status": { "type": ["string", "null"] },
    "authorization_negative_status": { "type": ["string", "null"] },
    "rollback_task_definition": { "type": ["string", "null"] },
    "rollback_image_digest": { "type": ["string", "null"] },
    "rollback_target_group": { "type": ["string", "null"] },
    "rollback_result": { "type": ["string", "null"] },
    "failure_stage": { "type": ["string", "null"] },
    "failure_reason": { "type": ["string", "null"] },
    "logs_path": { "type": ["string", "null"] },
    "aws_account": { "type": ["string", "null"] },
    "aws_region": { "type": ["string", "null"] },
    "release_notes": { "type": ["string", "null"] },
    "dry_run": { "type": "boolean" },
    "created_by_tool_version": { "type": ["string", "null"] },
    "updated_at": { "type": ["string", "null"], "format": "date-time" },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["timestamp", "from_state", "to_state", "result", "stage", "message", "operator", "evidence"],
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "from_state": { "type": ["string", "null"] },
          "to_state": { "type": "string", "minLength": 1 },
          "result": { "type": ["string", "null"] },
          "stage": { "type": ["string", "null"] },
          "message": { "type": ["string", "null"] },
          "operator": { "type": ["string", "null"] },
          "evidence": { "type": ["string", "null"] }
        }
      }
    }
  }
}
