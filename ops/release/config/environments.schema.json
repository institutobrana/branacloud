{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brana.local/schemas/environments.schema.json",
  "title": "Brana Cloud Release Environment Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment",
    "serviceType",
    "awsAccountId",
    "awsRegion",
    "ecsCluster",
    "ecsService",
    "taskFamily",
    "deploymentStrategy",
    "desiredCount",
    "minimumHealthyPercent",
    "maximumPercent",
    "productionTargetGroupArn",
    "publicHealthUrl",
    "publicAppUrl",
    "observationMinutes",
    "requestIntervalSeconds",
    "rollbackTaskDefinition",
    "requireCleanClone",
    "requireImageDigest",
    "requireZeroElb503",
    "requirePublicTargetHealthy",
    "requireOldTaskUntilNewHealthy",
    "logGroup",
    "runtimePlatform"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "2.0.0" },
    "environment": { "type": "string", "enum": ["hml", "prod"] },
    "serviceType": { "type": "string", "enum": ["STANDARD_ECS", "EXPRESS_GATEWAY"] },
    "awsAccountId": { "type": "string", "pattern": "^\\d{12}$" },
    "awsRegion": { "type": "string", "pattern": "^[a-z]{2}-[a-z]+-\\d$" },
    "ecsCluster": { "type": "string", "minLength": 1 },
    "ecsService": { "type": "string", "minLength": 1 },
    "taskFamily": { "type": "string", "minLength": 1 },
    "deploymentStrategy": { "type": "string", "enum": ["ROLLING", "CANARY"] },
    "desiredCount": { "type": "integer", "minimum": 1 },
    "minimumHealthyPercent": { "type": "integer", "minimum": 0, "maximum": 100 },
    "maximumPercent": { "type": "integer", "minimum": 100 },
    "canaryPercent": { "type": "integer", "minimum": 0, "maximum": 100 },
    "bakeTimeInMinutes": { "type": "integer", "minimum": 0 },
    "productionTargetGroupArn": { "type": "string", "minLength": 1 },
    "publicHealthUrl": { "type": "string", "minLength": 1 },
    "publicAppUrl": { "type": "string", "minLength": 1 },
    "observationMinutes": { "type": "integer", "minimum": 15 },
    "requestIntervalSeconds": { "type": "integer", "minimum": 1 },
    "rollbackTaskDefinition": { "type": "string", "minLength": 1 },
    "requireCleanClone": { "type": "boolean" },
    "requireImageDigest": { "type": "boolean" },
    "requireZeroElb503": { "type": "boolean" },
    "requirePublicTargetHealthy": { "type": "boolean" },
    "requireOldTaskUntilNewHealthy": { "type": "boolean" },
    "logGroup": { "type": "string", "minLength": 1 },
    "runtimePlatform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operatingSystemFamily", "cpuArchitecture"],
      "properties": {
        "operatingSystemFamily": { "type": "string", "enum": ["LINUX"] },
        "cpuArchitecture": { "type": "string", "enum": ["X86_64", "ARM64"] }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "serviceType": { "const": "EXPRESS_GATEWAY" }
        },
        "required": ["serviceType"]
      },
      "then": {
        "properties": {
          "deploymentStrategy": { "const": "CANARY" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "deploymentStrategy": { "const": "CANARY" }
        },
        "required": ["deploymentStrategy"]
      },
      "then": {
        "required": ["canaryPercent", "bakeTimeInMinutes"]
      }
    },
    {
      "if": {
        "properties": {
          "deploymentStrategy": { "const": "ROLLING" }
        },
        "required": ["deploymentStrategy"]
      },
      "then": {
        "not": {
          "properties": {
            "serviceType": { "const": "EXPRESS_GATEWAY" }
          },
          "required": ["serviceType"]
        }
      }
    }
  ]
}
