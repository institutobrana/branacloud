<Window x:Class="Brana.WindowsApproval.ApprovalWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Brana Cloude — Aprovação local" Width="520" Height="420" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Aprovação local" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18"/>
      <TextBlock Text="Origem" FontWeight="Bold"/><TextBlock x:Name="OriginText" Margin="0,2,0,10"/>
      <TextBlock Text="Documento técnico" FontWeight="Bold"/><TextBlock x:Name="NameText" Margin="0,2,0,10"/>
      <TextBlock Text="Código" FontWeight="Bold"/><TextBlock x:Name="CodeText" Margin="0,2,0,10"/>
      <TextBlock Text="Perfil / política" FontWeight="Bold"/><TextBlock x:Name="PolicyText" Margin="0,2,0,10"/>
      <TextBlock Text="Campo / posição" FontWeight="Bold"/><TextBlock x:Name="FieldText" Margin="0,2,0,10"/>
      <TextBlock x:Name="ExpiryText" Foreground="DarkOrange" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="DenyButton" Content="Negar" Width="100" Margin="0,12,8,0" Click="DenyClick"/>
      <Button x:Name="ApproveButton" Content="Aprovar" Width="100" Margin="0,12,0,0" Click="ApproveClick"/>
    </StackPanel>
  </Grid>
</Window>
